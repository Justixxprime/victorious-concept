# Copy this file to .env and fill in real values.
# Anything prefixed VITE_ is bundled into the browser and is PUBLIC —
# never put a real secret behind a VITE_ prefix.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# The following are server-only and are set in Vercel's dashboard
# (Settings -> Environment Variables), never in this file:
#   SUPABASE_SERVICE_ROLE_KEY
#   PAYSTACK_SECRET_KEY
#   RESEND_API_KEY
