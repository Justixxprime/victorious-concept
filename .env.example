# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Supabase (Project Settings -> API) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role key — server-side only (used by api/*.js). Full database
# access, bypasses RLS. Never expose this to the browser or prefix it
# with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (Settings -> API Keys & Webhooks) ---
VITE_PAYSTACK_PUBLIC_KEY=
# Secret key — server-side only (used by api/paystack-webhook.js and
# api/process-refund.js for refunds).
PAYSTACK_SECRET_KEY=

# --- Resend (for order confirmation emails) ---
RESEND_API_KEY=
